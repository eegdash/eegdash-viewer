{
  "name": "eeg-viewer",
  "private": true,
  "scripts": {
    "test": "node --test --test-reporter=spec --test-concurrency=1 tests/*.test.mjs",
    "test:unit": "node --test --test-reporter=spec tests/traces.test.mjs tests/unit-*.test.mjs tests/local-blob.test.mjs tests/tile-fetching.test.mjs tests/eegdash-fallback.test.mjs",
    "test:net": "node --test --test-reporter=spec --test-concurrency=1 tests/sidecars.test.mjs tests/eeglab.test.mjs tests/edf.test.mjs tests/brainvision.test.mjs tests/bdf.test.mjs",
    "test:integration": "node --test --test-reporter=spec --test-concurrency=1 tests/integration.test.mjs",
    "test:integration:gc": "node --expose-gc --test --test-reporter=spec --test-concurrency=1 tests/integration.test.mjs tests/integration-rapid-pan.test.mjs",
    "test:coverage": "c8 --reporter=text --reporter=html --reporter=json-summary node --test --test-reporter=spec tests/traces.test.mjs tests/unit-*.test.mjs tests/prop-*.test.mjs tests/local-blob.test.mjs tests/tile-fetching.test.mjs tests/eegdash-fallback.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:rapid": "playwright test tests/e2e/streaming.spec.mjs tests/e2e/rapid-scroll.spec.mjs tests/e2e/memory-streaming.spec.mjs --project=chromium",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.mjs",
    "test:visual:update": "playwright test tests/e2e/visual-regression.spec.mjs --update-snapshots",
    "test:smoke": "playwright test tests/e2e/smoke.spec.mjs --project=chromium",
    "test:acceptance": "playwright test tests/e2e/acceptance/ --project=chromium",
    "test:audit-reality": "playwright test tests/e2e/acceptance/audit-loadable.spec.mjs --project=chromium",
    "test:audit-reality:soft": "AUDIT_SOFT_FAIL=1 playwright test tests/e2e/acceptance/audit-loadable.spec.mjs --project=chromium",
    "report:audit-reality": "node scripts/audit-browser-reality-report.mjs",
    "test:perf": "node bench/check-regression.mjs",
    "test:typecheck": "tsc --noEmit -p jsconfig.json",
    "test:bench": "node bench/run-all.tinybench.mjs",
    "test:bench:filter": "node bench/filter.tinybench.mjs",
    "test:bench:parse": "node bench/parse-matv5.tinybench.mjs",
    "test:bench:cache": "node bench/worker-cache.tinybench.mjs",
    "test:bench:readwindow": "node bench/readwindow.tinybench.mjs",
    "test:fuzz": "node --test --test-timeout=120000 tests/fuzz-formats.test.mjs",
    "mutation": "stryker run",
    "mutation:incremental": "stryker run --incremental",
    "bench": "node scripts/bench-fetch.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@codspeed/tinybench-plugin": "^5.4.0",
    "@playwright/test": "^1.59.1",
    "@stryker-mutator/core": "^9.6.1",
    "c8": "^11.0.0",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "tinybench": "^6.0.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "jsfive": "^0.4.0"
  }
}
